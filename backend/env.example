# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=url_shortener

# Valkey
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_TTL=1h

# Application
APP_HOST=127.0.0.1
APP_PORT=8080
PRODUCTION=false
GIN_MODE=debug
TRUSTED_PROXIES=127.0.0.1

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h
